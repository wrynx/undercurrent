# Links lychee should not check (one regex per line). Used by the link-check
# job in .github/workflows/docs.yml. Each entry says why it is here.

# Local dev servers in the docs (`mkdocs serve`, the example HTTP server).
^https?://(localhost|127\.0\.0\.1)([:/]|$)

# Placeholder hosts in examples (webhook sink URLs and similar).
^https?://([a-z0-9-]+\.)*example\.(com|org|net)([:/]|$)

# Not live until go-public: the repo is still private (renamed to
# wrynx/undercurrent at launch), so these return 404 to an anonymous
# checker. Remove these three after the repo is public and Pages is
# deployed.
^https://github\.com/wrynx/undercurrent([/.?#]|$)
^https://raw\.githubusercontent\.com/wrynx/undercurrent/
^https://colab\.research\.google\.com/github/wrynx/undercurrent/
^https://wrynx\.github\.io/undercurrent([/?#]|$)

# Not live until the first release is uploaded to PyPI. Remove after v0.1.0.
^https://pypi\.org/project/undercurrent/?$
